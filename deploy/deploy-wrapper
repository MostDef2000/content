#!/usr/bin/env bash
# =============================================================================
# content deploy-wrapper — принудительная команда (forced command) для
# deploy-пользователя на GPU-боксе (ZeroTier 10.123.239.102). Вызывается
# только из .github/workflows/deploy.yml (GitHub runner -> РУ-хост
# 82.146.37.153 -> SSH ProxyJump -> бокс), паттерн sea-speed
# deploy-ubuntu-worker.yml / deploy-authorized.sh.
#
# Глаголы (первое слово SSH_ORIGINAL_COMMAND; всё остальное — отказ,
# fail-closed): forced command в authorized_keys не передаёт argv — команда
# клиента приходит в переменной окружения SSH_ORIGINAL_COMMAND:
#   content-deploy-v1 <sha>  — задеплоить точный 40-hex SHA из origin/main
#   content-status-v1        — состояние репозитория и стека (read-only)
#
# content-deploy-v1, по шагам (любая ошибка = откат):
#   1. cross-repo lock: flock (non-blocking) на /var/tmp/gpu-box-deploy.lock —
#      общий контракт GPU-бокса для content и sea-speed (T8a; ранее /run —
#      миграция на персистентный self-heal путь, см. шапку 3b); затем
#      внутрирепозиторный lock $STATE_DIR/deploy.lock
#   2. git fetch origin в чекауте $CONTENT_DIR (default /opt/content)
#   3. проверка, что SHA — предок origin/main (merge-base --is-ancestor)
#   4. предыдущий SHA -> $CONTENT_DIR/deploy-state/previous-sha
#   5. mirror-checkout <sha> (reset --hard + точечное удаление конфликтных
#      untracked + clean, кроме models/ и ignored — см. mirror_checkout)
#   6. docker compose build comfyui manager (сборка из исходников — долгая)
#      + пер-ША теги образов: valery-comfyui:<sha>, valery-manager:<sha>
#   7. docker compose up -d
#   8. health-цикл ~120 c, СТРОГО HTTP 200 (302/404 = не жив):
#      ComfyUI http://127.0.0.1:$COMFYUI_PORT/system_stats и manager
#      http://127.0.0.1:$MANAGER_PORT/api/status (порты читаются из
#      $CONTENT_DIR/.env так же, как их читает compose; connection refused /
#      таймаут — сервис ещё не готов)
#   9. deploy-state/deployment-manifest.json
#  10. маркер DEPLOYMENT_ACCEPTED sha=<sha> previous=<prev> в stdout
#  При ошибке после шага 4: автоматический откат на предыдущий SHA БЕЗ
#  пересборки (checkout prev + возврат дефолтных тегов на образы <image>:<prev>
#  + compose up -d --no-build), затем тот же строгий health-цикл и маркер
#  ROLLBACK_ACCEPTED / ROLLBACK_FAILED (sha/previous). Fail-closed, если тег
#  <image>:<prev> отсутствует (например, первый деплой после введения пер-ША
#  тегов — образа предыдущего SHA на боксе ещё нет).
#
# Bootstrap (однократно, Lane B — вручную или через sysadmin-агента):
#   1. Клонировать репо на бокс (read-only deploy key):
#        git clone git@github.com:MostDef2000/content.git /opt/content
#   2. Создать /opt/content/.env со строкой HF_TOKEN=... (значение живёт
#      ТОЛЬКО на боксе; chmod 600; в Git/чат не попадает).
#   3. Deploy-пользователь и права:
#        useradd -m -s /bin/bash content-deploy
#        usermod -aG docker content-deploy     # группа docker — допущение
#        chown -R content-deploy:content-deploy /opt/content  # /opt/content должен быть во владении/writable у deploy-юзера: git fetch/checkout в content-deploy-v1 выполняются от его имени
#        install -d -o content-deploy -m 0700 /opt/content/deploy-state
#   3b. Cross-repo deploy lock (общий контракт content/sea-speed, T8a) —
#       root-bootstrap НЕ нужен (self-heal): /var/tmp/gpu-box-deploy.lock
#       wrapper создаёт сам при отсутствии. /var/tmp выбран вместо /run:
#       персистентен (переживает reboot — /run это tmpfs, лок умирал при
#       каждой перезагрузке) и на стандартной Ubuntu имеет режим 1777, так
#       что deploy-пользователь может создать файл сам. Режим файла —
#       umask-независимые 0666: flock/чтение работают и на 0644 (fd
#       открывается read-only), а 0666 нужен, чтобы deploy-пользователь
#       другого репо (sea-speed, T8b) мог touch'ить файл — обновлять mtime
#       против tmpfiles-clean; чужой 0644-файл без права touch со временем
#       был бы вычищен.
#       systemd-tmpfiles-clean удаляет из /var/tmp файлы, неактивные >30
#       дней (usr/lib/tmpfiles.d/tmp.conf): wrapper делает touch файла при
#       каждом деплое — пока деплои идут, файл не стареет; после простоя
#       >30 дней следующий деплой пересоздаёт его автоматически (self-heal,
#       по-прежнему без root). Если на боксе остался старый root-файл
#       /run/gpu-box-deploy.lock — он больше не используется и может быть
#       удалён (в tmpfs и так исчезнет при reboot).
#   4. Установить этот файл на бокс:
#        install -o root -g root -m 0755 deploy/deploy-wrapper \
#          /usr/local/bin/content-deploy-wrapper
#   5. В authorized_keys deploy-ключа бокса одной строкой (forced command):
#        command="/usr/local/bin/content-deploy-wrapper",no-port-forwarding,no-X11-forwarding,no-agent-forwarding,no-pty ssh-ed25519 AAAA...
#      Путь репо переопределяется через CONTENT_DIR (env); для forced command —
#      environment="CONTENT_DIR=/путь" в authorized_keys + PermitUserEnvironment
#      в sshd, либо правкой дефолта в установленной копии.
#   6. GitHub Secrets/Vars (имена — в .github/workflows/deploy.yml, контракт
#      dispatch; единая программа деплоя — specs/deploy-unification/ в репо
#      ai-playground): secrets CONTENT_VPS_SSH_PRIVATE_KEY, CONTENT_BOX_SSH_PRIVATE_KEY,
#      CONTENT_VPS_HOST, CONTENT_VPS_USER, CONTENT_BOX_HOST, CONTENT_BOX_USER;
#      vars CONTENT_VPS_SSH_PORT (опц., default 22), CONTENT_VPS_KNOWN_HOSTS,
#      CONTENT_BOX_KNOWN_HOSTS (pinned ключи хостов; ssh-keyscan не используется).
#
# Известные риски (Lane C — НЕ чинить здесь, compose.yaml не трогаем; фиксация
# по решению владельца):
#   * manager публикует порт на всех интерфейсах ("${MANAGER_PORT:-8000}:8000"),
#     а не на 127.0.0.1 — кандидат на сужение биндинга;
#   * manager монтирует /var/run/docker.sock — root-эквивалентный доступ;
#   * ufw на боксе неактивен — решение владельца.
# =============================================================================

set -Eeuo pipefail
umask 077

CONTENT_DIR="${CONTENT_DIR:-/opt/content}"
STATE_DIR="$CONTENT_DIR/deploy-state"
PREV_FILE="$STATE_DIR/previous-sha"
LOCK_FILE="$STATE_DIR/deploy.lock"
MANIFEST="$STATE_DIR/deployment-manifest.json"
HEALTH_TIMEOUT_S="${HEALTH_TIMEOUT_S:-120}"
HEALTH_STEP_S="${HEALTH_STEP_S:-5}"

# Cross-repo deploy lock (T8a): единый путь на GPU-боксе для ВСЕХ репо,
# деплоящих на этот бокс — content сейчас, sea-speed принимает тот же путь
# позже (T8b). flock non-blocking в начале deploy-пути: параллельный деплой
# другого репо отклоняется. Путь в /var/tmp, а не /run: /var/tmp персистентен
# (переживает reboot) и на стандартной Ubuntu имеет режим 1777 — файл
# создаётся самим wrapper'ом (self-heal, root-bootstrap не нужен), режим
# 0666 umask-независимо — flock/read-only fd работают и без записи; 0666
# нужен, чтобы deploy-юзер другого репо мог touch'ить файл (обновлять
# mtime); touch при каждом деплое держит mtime свежим против
# systemd-tmpfiles-clean (удаляет неактивные >30 дней) — см. шапку 3b.
# Старый путь /run/gpu-box-deploy.lock больше не используется: остаточный
# root-файл там можно удалить.
GPU_BOX_LOCK_FILE="/var/tmp/gpu-box-deploy.lock"

# Имена образов фиксирует compose.yaml (name: valery + сервисы comfyui/manager
# без явных image: ключей -> <проект>-<сервис>). После build ставим пер-ША
# теги <image>:<sha> — их использует откат БЕЗ пересборки; docker image inspect
# ниже ловит рассинхрон с compose.yaml fail-closed, а не в момент отката.
COMFY_IMAGE="valery-comfyui"
MANAGER_IMAGE="valery-manager"

PREV_SHA=""

log()  { printf '[content-deploy] %s\n' "$*"; }
fail() { printf '[content-deploy] ERROR %s\n' "$*" >&2; exit 1; }

# Mirror-checkout (issue #1, инцидент деплоя 3cecdcf): чекаут = точное зеркало
# SHA. Plain checkout --detach (и reset --hard — та же защита git) abort-ится,
# если untracked-файл бокса конфликтует с целевым деревом; mirror-семантика:
#   1) конфликтные untracked (файлы, существующие в целевом SHA) удаляются
#      точечно ДО reset — только они, остальной untracked не трогается;
#   2) reset --hard перезаписывает tracked-правки (runtime-правки tracked-
#      файлов легитимно стираются: tracked = код, а не state);
#   3) clean -fd убирает остальной untracked-мусор (ignored — .env,
#      deploy-state/, mountpoint kohya/ — clean без -x не трогает), КРОМЕ
#      models/ (-e models/): runtime-конфиги моделей создаёт UI в чекауте —
#      их wipe ломал бы генерацию до следующего коммита конфигов.
# Runtime-стейт при этом живёт вне чекаута (VALERY_REGISTRY_PATH, DATA_ROOT) —
# см. management/main.py: registry переносится гуардом при первом старте.
mirror_checkout() {
  local sha="$1" label="$2"
  local conflicted preview
  conflicted="$(comm -12 \
    <(git -C "$CONTENT_DIR" ls-tree -r --name-only "$sha" | sort) \
    <(git -C "$CONTENT_DIR" ls-files --others --exclude-standard | sort) || true)"
  if [[ -n "$conflicted" ]]; then
    log "mirror-$label: удаляю $(wc -l <<<"$conflicted") конфликтных untracked-файлов перед reset"
    while IFS= read -r f; do rm -f -- "$CONTENT_DIR/$f"; done <<<"$conflicted"
  fi
  if ! git -C "$CONTENT_DIR" reset --hard --quiet "$sha"; then
    return 1
  fi
  preview="$(git -C "$CONTENT_DIR" clean -ndq -e models/ || true)"
  [[ -n "$preview" ]] && log "mirror-$label: clean удалит (dry-run): $(printf '%s ' $preview)"
  git -C "$CONTENT_DIR" clean -fdq -e models/ || true
  return 0
}

usage() {
  cat >&2 <<'USAGE'
usage:
  content-deploy-v1 <40-hex-sha>   deploy exact origin/main commit
  content-status-v1                print repo/stack status (read-only)
USAGE
  exit 64
}

compose() {
  docker compose --project-directory "$CONTENT_DIR" -f "$CONTENT_DIR/compose.yaml" "$@"
}

# Порт из .env бокса (compose интерполирует ${VAR:-default}); секреты из .env
# сюда не попадают — читаем только строку конкретного порта.
env_port() {
  local name="$1" default="$2" line=""
  if [[ -f "$CONTENT_DIR/.env" ]]; then
    line="$(grep -E "^${name}=" "$CONTENT_DIR/.env" | tail -n 1 | cut -d= -f2- || true)"
  fi
  [[ "$line" =~ ^[0-9]+$ ]] || line="$default"
  printf '%s' "$line"
}

# Живость: СТРОГО HTTP 200 (302/404 = не жив); connection refused / таймаут —
# сервис ещё не готов. Эндпоинты выбраны по исходникам приложений:
#   * ComfyUI: GET /system_stats — штатный API-эндпоинт ComfyUI; сам менеджер
#     использует его как проверку живости ComfyUI (management/main.py,
#     _comfy_up(): urlopen(f"{COMFY_URL}/system_stats") + resp.status == 200).
#   * manager: GET /api/status — реальный FastAPI-роут (management/main.py,
#     @app.get("/api/status")); корень / отдаёт статику и диагностическим
#     сигналом не является. Роут не требует авторизации (basicauth только на
#     nginx-фронте) и не зависит от ComfyUI (comfy_up деградирует в false,
#     а не в 5xx).
health_probe() {
  local url="$1" code
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "$url" || true)"
  [[ "$code" == "200" ]]
}

wait_for_health() {
  local comfy_url="$1" manager_url="$2" deadline=$((SECONDS + HEALTH_TIMEOUT_S))
  while (( SECONDS < deadline )); do
    if health_probe "$comfy_url" && health_probe "$manager_url"; then
      log "health OK: comfyui + manager"
      return 0
    fi
    log "waiting for health... ($((deadline - SECONDS))s left)"
    sleep "$HEALTH_STEP_S"
  done
  log "health не сошёлся за ${HEALTH_TIMEOUT_S}s: comfyui=$comfy_url manager=$manager_url"
  return 1
}

write_manifest() {
  local sha="$1" prev="$2" comfy_url="$3" manager_url="$4" ts
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  cat > "$MANIFEST.tmp" <<JSON
{
  "schema": "content_deployment_manifest_v1",
  "deployed_at": "$ts",
  "sha": "$sha",
  "previous": "$prev",
  "services": ["comfyui", "manager"],
  "health": {
    "comfyui": "$comfy_url",
    "manager": "$manager_url"
  }
}
JSON
  mv "$MANIFEST.tmp" "$MANIFEST"
  chmod 0600 "$MANIFEST"
  log "DEPLOYMENT_MANIFEST path=$MANIFEST"
}

# Откат БЕЗ пересборки: образы предыдущего успешного деплоя лежат на боксе под
# пер-ША тегами <image>:<prev> (ставятся на шаге 6 каждого деплоя). Порядок:
# checkout предыдущего SHA (compose.yaml того деплоя) -> fail-closed проверка
# тегов -> возврат дефолтных тегов (<image> = :latest) на предыдущие образы ->
# compose up -d --no-build (compose build НЕ вызывается) -> тот же строгий
# health-цикл -> маркер ROLLBACK_ACCEPTED / ROLLBACK_FAILED. Любой исход
# завершается exit 1: сам деплой провален, маркер отличает «откатился и
# здоров» от «откат не удался — нужно ручное вмешательство».
do_rollback() {
  local prev="$1"
  printf '[content-deploy] ERROR deployment failed, rolling back to %s\n' "$prev" >&2
  set +eE
  trap - ERR
  local rc=0
  # Та же mirror-семантика, что и в деплое (fail-closed: ошибка = exit 1).
  if ! mirror_checkout "$prev" rollback; then
    printf '[content-deploy] ROLLBACK_FAILED reason=checkout_failed sha=%s previous=%s\n' "${DEPLOYED_SHA:-unknown}" "$prev" >&2
    exit 1
  fi
  if ! docker image inspect "$COMFY_IMAGE:$prev" >/dev/null 2>&1 \
     || ! docker image inspect "$MANAGER_IMAGE:$prev" >/dev/null 2>&1; then
    printf '[content-deploy] ROLLBACK_FAILED reason=previous_image_tag_absent want=%s:%s+%s:%s sha=%s previous=%s (предыдущий образ недоступен — ручное вмешательство)\n' \
      "$COMFY_IMAGE" "$prev" "$MANAGER_IMAGE" "$prev" "${DEPLOYED_SHA:-unknown}" "$prev" >&2
    exit 1
  fi
  docker tag "$COMFY_IMAGE:$prev" "$COMFY_IMAGE" || rc=1
  docker tag "$MANAGER_IMAGE:$prev" "$MANAGER_IMAGE" || rc=1
  compose up -d --no-build || rc=1
  if (( rc != 0 )); then
    printf '[content-deploy] ROLLBACK_FAILED reason=restore_steps_failed rc=%s sha=%s previous=%s\n' "$rc" "${DEPLOYED_SHA:-unknown}" "$prev" >&2
    exit 1
  fi
  local comfy_port manager_port comfy_url manager_url
  comfy_port="$(env_port COMFYUI_PORT 8188)"
  manager_port="$(env_port MANAGER_PORT 8000)"
  comfy_url="http://127.0.0.1:${comfy_port}/system_stats"
  manager_url="http://127.0.0.1:${manager_port}/api/status"
  if wait_for_health "$comfy_url" "$manager_url"; then
    printf 'ROLLBACK_ACCEPTED sha=%s previous=%s\n' "${DEPLOYED_SHA:-unknown}" "$prev"
  else
    printf '[content-deploy] ROLLBACK_FAILED reason=health_failed sha=%s previous=%s (стек поднят на предыдущих образах, но health не сошёлся — ручное вмешательство)\n' "${DEPLOYED_SHA:-unknown}" "$prev" >&2
  fi
  exit 1
}

do_deploy() {
  local sha="$1"

  command -v git    >/dev/null 2>&1 || fail "git not found on box"
  command -v docker >/dev/null 2>&1 || fail "docker not found on box"
  command -v curl   >/dev/null 2>&1 || fail "curl not found on box"
  command -v flock  >/dev/null 2>&1 || fail "flock not found on box"
  [[ -f "$CONTENT_DIR/compose.yaml" ]] || fail "нет compose.yaml в $CONTENT_DIR (CONTENT_DIR?)"

  install -d -m 0700 "$STATE_DIR"

  # --- до записи состояния: проверки, ничего не мутируем -------------------
  # Cross-repo lock (T8a): не даём параллельного деплоя другого репо на этом
  # GPU-боксе. Self-heal, root-bootstrap не нужен: touch создаёт файл при
  # отсутствии (/var/tmp на стандартной Ubuntu имеет режим 1777) и обновляет
  # mtime при каждом деплое — systemd-tmpfiles-clean удаляет из /var/tmp
  # файлы, неактивные >30 дней (см. шапку 3b). Режим создаваемого файла —
  # umask-независимые 0666 (umask 000 внутри subshell): open+flock работает
  # и на 0644 (read-only fd), 0666 нужен, чтобы deploy-юзер другого репо
  # (sea-speed) мог touch'ить файл — обновлять mtime.
  # flock на read-only fd — ядро снимает lock при закрытии fd, а fd закрывается
  # при любом выходе процесса (включая ERR-trap/exit) — отдельной очистки нет
  # и ошибки trap её не портят.
  if ! ( umask 000 && touch "$GPU_BOX_LOCK_FILE" ) 2>/dev/null; then
    # Не фатально: например, файл создан вручную/root как 0644 (файл другого
    # deploy-юзера тут был бы 0666 — touch прошёл бы). Решает open+flock
    # ниже — если файл непригоден, там fail-closed.
    log "внимание: touch cross-repo lock не прошёл ($GPU_BOX_LOCK_FILE) — продолжаю, решит open+flock ниже"
  fi
  # Belt-and-suspenders: выровнять режим на 0666. chmod чужого файла падает
  # с EPERM — это НЕ фатально ТОЛЬКО при условии, что fd ниже открывается и
  # лочится; если файл создать/открыть/залочить нельзя — fail-closed ниже.
  chmod 0666 "$GPU_BOX_LOCK_FILE" 2>/dev/null || true
  exec 8<"$GPU_BOX_LOCK_FILE" \
    || fail "не открыть cross-repo lock $GPU_BOX_LOCK_FILE (self-heal не смог: нет прав на файл/каталог? — удалите файл от root, при следующем деплое он будет создан заново)"
  flock -n 8 || fail "another GPU-box deploy is active (cross-repo lock: content/sea-speed)"

  exec 9>>"$LOCK_FILE"
  flock -n 9 || fail "другой деплой уже выполняется (lock $LOCK_FILE)"

  git -C "$CONTENT_DIR" fetch --quiet origin
  git -C "$CONTENT_DIR" merge-base --is-ancestor "$sha" origin/main \
    || fail "sha $sha не достижим из origin/main — отказываюсь деплоить"

  local dirty
  dirty="$(git -C "$CONTENT_DIR" status --porcelain --untracked-files=no || true)"
  [[ -z "$dirty" ]] || log "внимание: в чекауте есть локальные правки tracked-файлов (не блокирует, но деплой может отклониться от ожиданий)"

  local prev comfy_port manager_port comfy_url manager_url
  prev="$(git -C "$CONTENT_DIR" rev-parse HEAD)"
  PREV_SHA="$prev"
  DEPLOYED_SHA="$sha"
  printf '%s\n' "$prev" > "$PREV_FILE.tmp"
  mv "$PREV_FILE.tmp" "$PREV_FILE"

  # --- с этого момента любая ошибка = автоматический откат ------------------
  trap 'do_rollback "$PREV_SHA"' ERR

  log "DEPLOY_MUTATION target=$sha previous=$prev"
  mirror_checkout "$sha" deploy || fail "mirror-checkout $sha не удался (reset abort?)"

  comfy_port="$(env_port COMFYUI_PORT 8188)"
  manager_port="$(env_port MANAGER_PORT 8000)"
  comfy_url="http://127.0.0.1:${comfy_port}/system_stats"
  manager_url="http://127.0.0.1:${manager_port}/api/status"

  log "docker compose build (comfyui + manager) — это долго"
  compose build comfyui manager
  # Пер-ША теги для отката без пересборки: валидируем дефолтные имена образов
  # и ставим <image>:<sha> (см. комментарий у COMFY_IMAGE/MANAGER_IMAGE).
  docker image inspect "$COMFY_IMAGE" >/dev/null \
    || fail "образ $COMFY_IMAGE не найден после compose build (изменился нейминг в compose.yaml?)"
  docker image inspect "$MANAGER_IMAGE" >/dev/null \
    || fail "образ $MANAGER_IMAGE не найден после compose build (изменился нейминг в compose.yaml?)"
  docker tag "$COMFY_IMAGE" "$COMFY_IMAGE:$sha"
  docker tag "$MANAGER_IMAGE" "$MANAGER_IMAGE:$sha"
  log "images tagged for rollback: $COMFY_IMAGE:$sha $MANAGER_IMAGE:$sha"
  log "docker compose up -d"
  compose up -d

  # Голый вызов: возврат 1 уходит в ERR trap -> do_rollback (через `|| fail`
  # ловушка ERR не срабатывает — это и был баг отката).
  wait_for_health "$comfy_url" "$manager_url"

  write_manifest "$sha" "$prev" "$comfy_url" "$manager_url"

  trap - ERR
  printf 'DEPLOYMENT_ACCEPTED sha=%s previous=%s\n' "$sha" "$prev"
}

do_status() {
  [[ -d "$CONTENT_DIR/.git" ]] || fail "нет репозитория в $CONTENT_DIR (CONTENT_DIR=$CONTENT_DIR)"
  local comfy_port manager_port comfy_url manager_url code
  log "repo=$CONTENT_DIR"
  git -C "$CONTENT_DIR" log --oneline -n 1 || true
  if [[ -f "$PREV_FILE" ]]; then
    log "previous-sha=$(cat "$PREV_FILE")"
  else
    log "previous-sha=(нет файла состояния)"
  fi
  compose ps || true
  comfy_port="$(env_port COMFYUI_PORT 8188)"
  manager_port="$(env_port MANAGER_PORT 8000)"
  comfy_url="http://127.0.0.1:${comfy_port}/system_stats"
  manager_url="http://127.0.0.1:${manager_port}/api/status"
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "$comfy_url" || true)"
  log "comfyui $comfy_url -> ${code:-000}"
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "$manager_url" || true)"
  log "manager $manager_url -> ${code:-000}"
  # status — read-only диагностика: всегда exit 0, факты видны в логе выше.
  exit 0
}

# sshd с forced command (authorized_keys) не передаёт аргументов — команда
# клиента приходит целиком в SSH_ORIGINAL_COMMAND. Диспетчеризация — точное
# сопоставление (allowlist), без eval, без sh -c от ввода клиента.
cmd="${SSH_ORIGINAL_COMMAND:-}"
if [[ "$cmd" =~ ^content-deploy-v1\ ([0-9a-f]{40})$ ]]; then
  do_deploy "${BASH_REMATCH[1]}"
elif [[ "$cmd" == "content-status-v1" ]]; then
  do_status
else
  usage
fi
